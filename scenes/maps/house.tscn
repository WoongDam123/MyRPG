[node name="Map" type="Node2D" unique_id=1988131271]
script = ExtResource("1_74y64")
map_name = "우리 집"
camera_zoom = 2.0
fx_profile = "indoor"
enter_event_flag = "intro_done"
enter_event_lines = [{
"name": "엄마",
"text": "어머, 이제야 일어났니? 잠꾸러기 같으니라고."
}, {
"name": "엄마",
"text": "벌써 해가 중천이야. 내일이 네 성인식인 거 잊지 않았지?"
}, {
"name": "엄마",
"text": "아빠가 밭에서 너를 찾으시더라. 나가서 인사드리렴."
}, {
"name": "",
"text": "(…이상한 꿈을 꾼 것 같다. 별이 가득한 곳에서, 누군가 나에게 말을 걸던…)"
}]

