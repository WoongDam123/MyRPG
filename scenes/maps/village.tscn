[node name="Dad" type="StaticBody2D" parent="World" unique_id=1702144401 instance=ExtResource("10_uw434")]
position = Vector2(560, 360)
script = ExtResource("11_n0rsa")
npc_name = "아빠"
texture = ExtResource("12_d4t0j")
lines = Array[String](["오, 우리 집 잠꾸러기 왔구나!", "내일이면 너도 어엿한 그라니아의 성인이지. 시간 참 빠르구나.", "성인식 전에 몇 가지 부탁할 게 있단다. 준비가 되면 다시 이야기하자꾸나."])
story_id = "dad"

[node name="Bori" type="StaticBody2D" parent="World" unique_id=1248607628 instance=ExtResource("10_uw434")]
position = Vector2(424, 216)
script = ExtResource("11_n0rsa")
npc_name = "보리"
texture = ExtResource("13_u8imu")
lines = Array[String](["안녕! 내일 성인식이지? 부럽다~", "나도 빨리 어른이 돼서 바위 숲 너머로 가 보고 싶어.", "아 참, 바위 숲엔 슬라임이 나오니까 조심해! 동쪽 큰길 끝의 포탈로 가면 돼."])
facing = "left"

