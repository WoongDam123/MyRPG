npc_name = "아빠"
texture = ExtResource("10_2j656")
lines = Array[String](["오, 우리 집 잠꾸러기 왔구나!", "내일이면 너도 어엿한 그라니아의 성인이지. 시간 참 빠르구나.", "성인식 전에 몇 가지 부탁할 게 있단다. 준비가 되면 다시 이야기하자꾸나."])
story_id = "dad"

[node name="Bori" type="StaticBody2D" parent="World" unique_id=1424129189 instance=ExtResource("8_5nr1w")]
position = Vector2(424, 216)
