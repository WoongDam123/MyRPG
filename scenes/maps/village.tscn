npc_name = "보리"
texture = ExtResource("11_ew6p2")
lines = Array[String](["안녕! 내일 성인식이지? 부럽다~", "나도 빨리 어른이 돼서 바위 숲 너머로 가 보고 싶어.", "아 참, 바위 숲엔 슬라임이 나오니까 조심해! 동쪽 큰길 끝의 포탈로 가면 돼."])
